/* While loop program */
counter, limit: int;
{
    counter = 1;
    limit = 5;
    while (counter <= limit)
    {
        output(counter);
        counter = counter + 1;
    }
}

/* 
Expected translation to QUAD:
IASN temp1 1
IASN counter temp1
IASN temp2 5
IASN limit temp2
IGRT temp3 counter limit
IEQL temp4 temp3 0
JMPZ 11 temp4
IPRT counter
IADD temp5 counter 1
IASN counter temp5
JUMP 5
HALT
// Efrat Trabelsi
*/
