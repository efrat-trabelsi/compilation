/* Switch statement */
choice: int;
{
    input(choice);
    switch (choice) {
    case 1:
        output(100);
        break;
    case 2:
        output(200);
    default:
        output(999);
    }
}

/* 
Expected translation to QUAD:
IINP choice
IEQL temp1 choice 1
JMPZ 7 temp1
IASN temp2 100
IPRT temp2
JUMP 13
IEQL temp3 choice 2
JMPZ 11 temp3
IASN temp4 200
IPRT temp4
IASN temp5 999
IPRT temp5
HALT
// Efrat Trabelsi
*/
