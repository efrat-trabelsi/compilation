/* Simple assignment program */
a, b: int;
c: float;
{
    a = 5;
    b = 10;
    c = 3.14;
    output(a);
    output(b);
    output(c);
}

/* 
Expected translation to QUAD:
IASN temp1 5
IASN a temp1
IASN temp2 10
IASN b temp2
RASN temp3 3.140000
RASN c temp3
IPRT a
IPRT b
RPRT c
HALT
// Efrat Trabelsi
*/
