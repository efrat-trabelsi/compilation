Grammar

    0 $accept: program $end

    1 program: declarations stmt_block

    2 declarations: declarations declaration
    3             | ε

    4 declaration: idlist ':' type ';'

    5 type: INT
    6     | FLOAT

    7 idlist: idlist ',' ID
    8       | ID

    9 stmt: assignment_stmt
   10     | input_stmt
   11     | output_stmt
   12     | if_stmt
   13     | while_stmt
   14     | switch_stmt
   15     | break_stmt
   16     | stmt_block

   17 assignment_stmt: ID '=' expression ';'

   18 input_stmt: INPUT '(' ID ')' ';'

   19 output_stmt: OUTPUT '(' expression ')' ';'

   20 @1: ε

   21 $@2: ε

   22 if_stmt: IF '(' boolexpr ')' @1 stmt ELSE $@2 stmt

   23 @3: ε

   24 @4: ε

   25 while_stmt: WHILE @3 '(' boolexpr ')' @4 stmt

   26 @5: ε

   27 $@6: ε

   28 switch_stmt: SWITCH '(' expression ')' '{' @5 caselist DEFAULT ':' $@6 stmtlist '}'

   29 $@7: ε

   30 caselist: caselist CASE NUM ':' $@7 stmtlist
   31         | ε

   32 break_stmt: BREAK ';'

   33 stmt_block: '{' stmtlist '}'

   34 stmtlist: stmtlist stmt
   35         | ε

   36 boolexpr: boolexpr OR boolterm
   37         | boolterm

   38 boolterm: boolterm AND boolfactor
   39         | boolfactor

   40 boolfactor: NOT '(' boolexpr ')'
   41           | expression RELOP expression

   42 expression: expression ADDOP term
   43           | term

   44 term: term MULOP factor
   45     | factor

   46 factor: '(' expression ')'
   47       | CAST '(' expression ')'
   48       | ID
   49       | NUM


Terminals, with rules where they appear

    $end (0) 0
    '(' (40) 18 19 22 25 28 40 46 47
    ')' (41) 18 19 22 25 28 40 46 47
    ',' (44) 7
    ':' (58) 4 28 30
    ';' (59) 4 17 18 19 32
    '=' (61) 17
    '{' (123) 28 33
    '}' (125) 28 33
    error (256)
    ID <name> (258) 7 8 17 18 48
    NUM <num_val> (259) 30 49
    BREAK (260) 32
    CASE (261) 30
    DEFAULT (262) 28
    ELSE (263) 22
    FLOAT (264) 6
    IF (265) 22
    INPUT (266) 18
    INT (267) 5
    OUTPUT (268) 19
    SWITCH (269) 28
    WHILE (270) 25
    RELOP <op> (271) 41
    ADDOP <op> (272) 42
    MULOP <op> (273) 44
    OR (274) 36
    AND (275) 38
    NOT (276) 40
    CAST <cast_type> (277) 47


